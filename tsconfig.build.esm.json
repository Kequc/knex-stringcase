{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "./dist/esm",
        "rootDir": "./src",

        "target": "ES2020",
        "lib": ["ES2020"],

        "module": "nodenext",
        "moduleResolution": "nodenext",

        "declaration": true,
        "declarationMap": false,

        "verbatimModuleSyntax": false,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["test", "**/*.test.ts", "**/*.spec.ts"]
}
